# Settings of a robot_tests run. Copy to .env and fill in the broker credentials.
# The names are the ones the procedure-tools command uses, so one file drives both.

# CDB API
API_HOST=http://api.master.k8s.prozorro.gov.ua
API_TOKEN=broker_api_token
API_PATH=/api/2.5/

# Document service
DS_HOST=http://ds.k8s.prozorro.gov.ua
DS_USERNAME=broker_ds_username
DS_PASSWORD=broker_ds_password

# Reviewer and bot tokens
REVIEWER_TOKEN=reviewer_token
BOT_TOKEN=bot_token

# How much faster than real time the procedures run
ACCELERATION=20000
SUBMISSION=quick(mode:fast-forward)

# Robot options: --include smoke runs only the smoke tests,
# --include reporting or --include aboveThreshold picks one procedure.
ROBOT_OPTIONS=--loglevel ERROR

# Optional
# SEED=1
# WAIT=edr-qualification
# DEBUG=true
# DEBUG_REQUEST=true
